# 独立测试/评测环境示例。复制为 .env.eval 后使用（.env.eval 已被忽略）。
# 必须与业务配置分开：POSTGRES_TEST_DB 不能等于 POSTGRES_DB，端口和 Compose 项目名也不应与生产相同。
POSTGRES_USER=opssop
POSTGRES_PASSWORD=change-me-eval-password
POSTGRES_DB=opssop_eval
POSTGRES_PORT=15432
POSTGRES_TEST_DB=opssop_eval_test

SECRET_KEY=change-me-eval-secret
OPSSOP_ENV=development
OPSSOP_ADMIN_USERNAME=admin
OPSSOP_ADMIN_PASSWORD=change-me-admin-password
OPSSOP_SEED_DEMO=0

AI_MODE=disabled
EMBEDDING_MODE=disabled
LOCAL_ONLY=1

BACKEND_PORT=18000
FRONTEND_PORT=18080