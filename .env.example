# OpsSOP 环境变量示例。复制为 .env 后填写真实值。
# .env 已被 .gitignore 忽略,禁止提交真实密钥。

# ===== 数据库 =====
POSTGRES_USER=opssop
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=opssop
POSTGRES_PORT=5432

# ===== 后端 =====
# 会话签名密钥:生产必须替换为随机长字符串(如 openssl rand -hex 32)
SECRET_KEY=change-me-random-secret
# 会话有效期(小时)
SESSION_EXPIRE_HOURS=8
# production 时拒绝已知默认口令;本地演示用 development
OPSSOP_ENV=development
# 测试库(容器内 pytest 使用)
POSTGRES_TEST_DB=opssop_test

# ===== 初始账号 =====
# 首次启动时创建的管理员账号(生产必须改掉默认口令)
OPSSOP_ADMIN_USERNAME=admin
OPSSOP_ADMIN_PASSWORD=change-me-admin-password

# 是否种子演示账号(operator/reviewer,仅供本地演示;生产置 0)
OPSSOP_SEED_DEMO=1
OPSSOP_DEMO_OPERATOR_PASSWORD=demo-operator-password
OPSSOP_DEMO_REVIEWER_PASSWORD=demo-reviewer-password

# ===== AI 模型 =====
# disabled | demo | cloud | local —— 未配置时为 disabled,不会静默切换到 demo
AI_MODE=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
# 能力开关:不同服务对结构化输出/usage 支持不一致,按目标服务显式开启(0/1)
AI_SUPPORTS_JSON_MODE=0
AI_SUPPORTS_USAGE=0
# 单次分析的上下文/输出与单用户限流
AI_MAX_CONTEXT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=2048
AI_RATE_LIMIT_PER_MINUTE=6
AI_MAX_CONCURRENT_PER_USER=2
# embedding 独立配置:disabled | cloud | local(第三阶段第二批)
EMBEDDING_MODE=disabled
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# embedding 请求限制:超时/单批条数/单条文本长度上限
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_INPUT_CHARS=6000
# 查询向量独立限流(与聊天 AI_RATE_LIMIT 分离;限流时检索降级关键词,不影响分析额度)
EMBEDDING_RATE_LIMIT_PER_MINUTE=30
EMBEDDING_MAX_CONCURRENT_PER_USER=4
# 启用后禁止聊天与 embedding 使用 cloud 配置(应用级约束,不等于网络隔离)
LOCAL_ONLY=0

# ===== 前端(可选覆盖)=====
FRONTEND_PORT=8080
