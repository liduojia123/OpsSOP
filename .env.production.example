# OpsSOP 生产配置示例。复制为 .env.production 后填入随机值。
# .env.production 已被 .gitignore 忽略;不要提交真实口令/密钥。
#
# 启动:
#   docker compose -p opssop-prod --env-file .env.production \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# 说明:
# - 生产模式禁止示例默认口令和 OPSSOP_SEED_DEMO=1;
# - 数据库/后端不发布宿主端口,前端只绑定 127.0.0.1,由宿主反向代理提供 HTTPS;
# - 模型与 embedding 默认 disabled;由部署管理员按数据边界配置启用。

POSTGRES_USER=opssop
POSTGRES_PASSWORD=replace-with-random-db-password
POSTGRES_DB=opssop_prod
# 仅测试库使用;生产 compose 不发布数据库端口
POSTGRES_TEST_DB=opssop_test

SECRET_KEY=replace-with-32-plus-random-secret
SESSION_EXPIRE_HOURS=8
OPSSOP_ENV=production
OPSSOP_ADMIN_USERNAME=admin
OPSSOP_ADMIN_PASSWORD=replace-with-strong-random-admin-password
OPSSOP_SEED_DEMO=0

AI_MODE=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODE=disabled
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
LOCAL_ONLY=1

# 仅本机回环;外部 HTTPS 由宿主 nginx/Caddy 等反向代理负责
FRONTEND_PORT=8080

# 可信反向代理网段(逗号分隔 CIDR)。容器内 Nginx 位于 Docker 网络,
# 默认 172.16.0.0/12;留空表示忽略 X-Forwarded-For。
TRUSTED_PROXY_CIDRS=172.16.0.0/12
