# OpsSOP 生产配置示例。复制为 .env.production 后填入随机值。
# .env.production 已被 .gitignore 忽略;不要提交真实口令/密钥。
#
# 启动:
#   docker compose -p opssop-prod --env-file .env.production \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# 说明:
# - 生产模式禁止示例默认口令和 OPSSOP_SEED_DEMO=1;
# - 数据库/后端不发布宿主端口,前端只绑定 127.0.0.1,由宿主反向代理提供 HTTPS;
# - 模型与 embedding 默认 disabled;由部署管理员按数据边界配置启用。

POSTGRES_USER=opssop
POSTGRES_PASSWORD=replace-with-random-db-password
POSTGRES_DB=opssop_prod
# 仅测试库使用;生产 compose 不发布数据库端口
POSTGRES_TEST_DB=opssop_test

SECRET_KEY=replace-with-32-plus-random-secret
SESSION_EXPIRE_HOURS=8
OPSSOP_ENV=production
OPSSOP_ADMIN_USERNAME=admin
OPSSOP_ADMIN_PASSWORD=replace-with-strong-random-admin-password
OPSSOP_SEED_DEMO=0

AI_MODE=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODE=disabled
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
LOCAL_ONLY=1

# 仅本机回环;外部 HTTPS 由宿主 nginx/Caddy 等反向代理负责
FRONTEND_PORT=8080

# 可信反向代理网段(逗号分隔 CIDR)。容器内 Nginx 位于 Docker 网络,
# 默认 172.16.0.0/12;留空表示忽略 X-Forwarded-For。
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# ===== 平台内置备份 =====
# 生产环境启用每日任务;目录由 compose 挂载到宿主机 BACKUP_HOST_DIR
BACKUP_ENABLED=true
BACKUP_HOST_DIR=/data/OpsSop/BackUp
BACKUP_DIR=/data/OpsSop/BackUp
# 服务器本地时间(建议 0-5 点),每天一次
BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=30
TZ=Asia/Shanghai

# ===== 应用日志文件(可选)=====
# 默认 false:仅 stdout(容器 json-file 按 10MB × 5 轮转,不按时间保留)。
# 需要 30 天日志留存时改为 true,应用日志按天轮转写入 LOG_HOST_DIR
# 并自动清理超过 LOG_RETENTION_DAYS 的旧文件;也可不改配置,由宿主
# logrotate 或日志平台负责(见 docs/deployment.md)。
LOG_FILE_ENABLED=false
LOG_HOST_DIR=/data/OpsSop/Logs
LOG_DIR=/data/OpsSop/Logs
LOG_RETENTION_DAYS=30

# ===== 邮件接口(预留)=====
# 当前 disabled:注册/找回密码流程未启用,不对外发信。
# 后续接入 SMTP 时改为 smtp 并填写以下配置。
EMAIL_MODE=disabled
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
# 587 用 STARTTLS(true);465 隐式 SSL 时设 EMAIL_USE_SSL=true 并关闭 TLS
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# 备份失败/超过 26 小时无成功备份时发信;留空不发送
ALERT_EMAIL_TO=